# Copia este archivo a .env y cambia TODOS los valores. No subas nunca el .env.
DB_PASSWORD=cambia-esto
DB_ROOT_PASSWORD=cambia-esto
# Genera uno largo y aleatorio:  openssl rand -hex 32
APP_JWT_SECRET=cambia-esto-por-un-secreto-largo
# Orígenes permitidos por CORS, separados por comas
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Contraseña inicial del usuario "admin" (cámbiala tras el primer acceso)
ADMIN_INITIAL_PASSWORD=cambia-esto
# URL pública de la API; las fotos se sirven en <esta URL>/uploads/ (lo hace Nginx)
UPLOAD_PUBLIC_BASE_URL=http://localhost:8080
# Carpeta del servidor donde se guardan las fotos de los productos (por defecto ./uploads)
# UPLOADS_DIR=/srv/corebar/uploads
